# Pour le développement local (jamais dans Git). En production, le workflow génère le .env à partir des secrets GitHub.
PORT=8000

# Secret de signature des jetons : openssl rand -hex 32
TOKEN_SECRET=

# Boîte contact@liutwin.com chez l'hébergeur mail du domaine
# OVH : ssl0.ovh.net / 465 — Zoho : smtp.zoho.eu / 465
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@liutwin.com
SMTP_PASSWORD=

# Destinataire des messages (la même boîte, ou ta boîte perso)
MAIL_TO=contact@liutwin.com
